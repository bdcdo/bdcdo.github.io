@article{waldron_o_2022,
	title = {O cerne da posição contrária à revisão judicial},
	volume = {18},
	copyright = {Copyright (c) 2022},
	issn = {2317-6172},
	html = {https://periodicos.fgv.br/revdireitogv/article/view/86488},
	abstract = {Este ensaio apresenta a posição geral contrária à revisão judicial de legislação de maneira clara e sem se deter em discussões sobre decisões específicas ou na história de sua emergência em sistemas específicos de direito constitucional. O ensaio critica a revisão judicial sob duas bases principais. Primeiro, argumenta-se que não há razão para supor que direitos são mais bem protegidos por essa prática do que por legislaturas democráticas. Em segundo lugar, argumenta-se que, independentemente dos resultados que ela gera, a revisão judicial é democraticamente ilegítima. O segundo argumento é conhecido; o primeiro, não tanto. A posição contrária à revisão judicial não é, contudo, absoluta ou incondicional. Neste ensaio, ela pressupõe diversas condições, incluindo as de que a sociedade em questão tenha instituições democráticas que funcionem bem e que a maioria de seus cidadãos leve os direitos a sério (mesmo se eles discordarem sobre quais direitos eles têm). Este ensaio finaliza examinando o que decorre da ausência dessas condições.},
	language = {pt},
	number = {2},
	urldate = {2024-09-04},
	journal = {Revista Direito GV},
	author = {Waldron, Jeremy},
	translator = {Oliveira, Bruno da Cunha de and Wang, Daniel Wei Liang and Ghirardi, José Garcez},
	month = aug,
	year = {2022},
	additional_info = {Tradução para o português de "The Core of the Case Against Judicial Review" feita por mim, pelo Daniel Wei Liang Wang e pelo José Garcez Ghirardi.},
	keywords = {constitucionalismo, democracia, direitos, legislação, Revisão judicial},
	pdf = {waldron_o_2022.pdf},
	preview = {Layout 1_page-0001.jpg}
}

@phdthesis{oliveira_criacao_2021,
