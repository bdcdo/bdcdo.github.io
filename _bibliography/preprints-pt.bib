@article{oliveira_natjus_2026,
	title = {Judicialização da saúde e as divergências entre os Núcleos de Apoio Técnico do Judiciário (NatJus): uma análise empírica},
	abstract = {Os Núcleos de Apoio Técnico do Judiciário (NatJus) são órgãos que têm a função de oferecer suporte técnico a magistrados em casos envolvendo pedidos judiciais de tratamentos de saúde. A importância desses órgãos aumentou recentemente com as decisões do Supremo Tribunal Federal no Tema 6 de Repercussão Geral, sobre pedidos judiciais de medicamentos não incorporados ao Sistema Único de Saúde, e na ADI 7265, sobre pedidos judiciais de tratamentos não incorporados ao rol da Agência Nacional de Saúde Suplementar. Em ambas as decisões, o STF determinou a obrigatoriedade de magistrados consultarem os NatJus, sempre que disponíveis na respectiva jurisdição, ou outros entes ou pessoas com expertise técnica em saúde. Diante desse quadro, este estudo analisou 273.734 notas técnicas sobre medicamentos registradas na plataforma e-NatJus e emitidas por um total de 25 NatJus distintos. Os resultados apontam para a existência de grande disparidade nas recomendações de diferentes NatJus, mesmo controlando para uma série de características dos casos individuais.},
	type = {preprint},
	note = {Preprint},
	code = {https://github.com/lab-dados/natjus-divergencias},
	language = {pt},
	journal = {SciELO Preprints},
	author = {Oliveira, Bruno da Cunha de and Wang, Daniel Wei Liang and Trecenti, Julio and Brajal, Beatriz},
	month = sep,
	year = {2026},
	pdf = {oliveira_natjus_2026.pdf},
	additional_info = {Repercussão na imprensa: [Futuro da Saúde](https://futurodasaude.com.br/pareceres-dos-natjus-para-tratamentos-variam-entre-estados-aponta-estudo/) e [JOTA](https://mailchi.mp/jota/relatorio-especial-24082026-dispositivos-medicos-8891134).},
	preview = {oliveira_natjus_2026_page-0001.jpg}
}

@article{oliveira_et_al_2025,
	title = {Judicialização de tratamentos para o Transtorno do Espectro Autista no âmbito da saúde suplementar: Análise de sentenças proferidas pelo TJSP em 2023},
	type = {preprint},
	shorttitle = {Judicialização de tratamentos para o Transtorno do Espectro Autista no âmbito da saúde suplementar},
	html = {https://preprints.scielo.org/index.php/scielo/preprint/view/11566},
	doi = {10.1590/SciELOPreprints.11566},
	note = {Preprint},
	abstract = {Apesar da relevância econômica, jurídica e social do tema da judicialização de tratamentos para o Transtorno do Espectro Autista, o assunto ainda não foi abordado em profundidade pela literatura acadêmica. Para preencher essa lacuna, foi realizada a análise sistemática do conteúdo de uma amostra representativa de sentenças proferidas pelo TJSP em 2023. Nesse período, houve um predomínio de crianças bastante jovens entre os demandantes: a média de idade foi de cerca de seis anos e a mediana, de quatro anos e dez meses. Os principais tratamentos demandados foram consultas com fonoaudiólogos, terapeutas ocupacionais e psicólogos. Em 66% dos casos houve pedido por profissional que adotasse a técnica ABA (Applied Behavior Analysis). Os principais argumentos apresentados pelas operadoras de planos de saúde estão associados a discussões jurídicas sobre a existência de obrigação de cobertura dos tratamentos pleiteados. Já o principal argumento utilizado pelos magistrados foi o de que não caberia ao Judiciário nem à operadora revisar a prescrição feita pelo médico do paciente. Para fundamentar as suas decisões, os magistrados se ampararam principalmente na jurisprudência e nas súmulas do próprio TJSP, além do Código de Defesa do Consumidor. A taxa de sucesso total ou parcial dos pacientes foi de 92%.},
	language = {pt},
	urldate = {2025-04-07},
	journal = {SciELO Preprints},
	author = {Oliveira, Bruno da Cunha de and Penha, Maria Sthefanny Cavalcante da and Rodrigues, Giulia Beatriz Brombine Alves and Püschel, Mariana Araujo and Boarati, Vanessa},
	month = apr,
	year = {2025},
	pdf = {oliveira_et_al_2025.pdf},
	additional_info={Repercussão na imprensa: [Folha de São Paulo](https://www1.folha.uol.com.br/equilibrioesaude/2025/03/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude.shtml) (republicado em: [ICL Notícias](https://iclnoticias.com.br/autistas-ganham-9-cada-10-acoes-judiciais/), [Jornal de Brasília](https://jornaldebrasilia.com.br/noticias/saude/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude/), [Amazonas Repórter](https://amazonasreporter.com/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude/), [Vitória News](https://vitorianews.com.br/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude/), [O Juricaba](https://oajuricaba.com.br/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude/), [Contexto Notícias](https://contextonoticias.com.br/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude/) e [Portal do Holanda](https://www.portaldoholanda.com.br/variedades/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude)).},
	preview={oliveira_et_al_2025_page-0001.jpg}
}

@article{rocha_barreiras_2025,
	title = {Barreiras para a Implementação de uma Política Nacional de Rastreamento de Câncer de Pulmão},
	type = {preprint},
	html = {https://preprints.scielo.org/index.php/scielo/preprint/view/12922},
	doi = {10.1590/SciELOPreprints.12922},
	note = {Preprint},
	abstract = {O câncer de pulmão é a principal causa de morte por câncer no Brasil. Embora o rastreamento por tomografia computadorizada de baixa dosagem (TCBD) seja eficaz para a detecção precoce, sua implementação no Sistema Único de Saúde (SUS) enfrenta barreiras significativas. Este estudo, baseado em entrevistas com 18 especialistas, mapeou essas barreiras utilizando o Consolidated Framework for Implementation Research (CFIR). Os resultados revelam desafios multifacetados. No domínio das características da inovação, há incertezas sobre a aplicação das evidências internacionais no contexto epidemiológico brasileiro, com o risco de aumento de falsos-positivos devido a doenças como a tuberculose. O contexto externo aponta para as desigualdades regionais e a instabilidade no financiamento como grandes obstáculos. No contexto interno, a escassez de recursos humanos e equipamentos, e a falta de coordenação de cuidados foram destacadas. As barreiras individuais incluem a carência de profissionais especializados, a necessidade de capacitação e a baixa adesão dos pacientes, influenciada por fatores logísticos e pelo estigma da doença. Por fim, o processo de implementação é prejudicado pela ausência de dados robustos para um planejamento eficaz e monitoramento contínuo. Conclui-se que, para uma implementação bem-sucedida, é essencial considerar e planejar soluções para essas barreiras, adaptando a política à realidade complexa do SUS.},
	language = {pt},
	journal = {SciELO Preprints},
	author = {Rocha, Mariana Skaf Esteves da and Püschel, Mariana Araujo and Boarati, Vanessa and Oliveira, Bruno da Cunha de and Melo, Carolina},
	year = {2025},
	pdf = {rocha_barreiras_2025.pdf},
	preview = {rocha_barreiras_2025_page-0001.jpg}
}
