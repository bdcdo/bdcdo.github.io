@article{oliveira_natjus_2026,
	title = {Health litigation and divergences among Brazil's Judiciary Technical Support Centers (NatJus): an empirical analysis},
	abstract = {Brazil's Judiciary Technical Support Centers (NatJus) are bodies whose function is to provide technical support to judges in cases involving court claims for health treatments. Their importance has recently grown with the decisions of the Federal Supreme Court (STF) in General Repercussion Theme 6, on court claims for medicines not incorporated into the Unified Health System (SUS), and in Direct Action of Unconstitutionality (ADI) 7265, on court claims for treatments not included in the list of mandatory coverage of the National Supplementary Health Agency (ANS). In both decisions, the STF made it mandatory for judges to consult the NatJus, whenever available in the respective jurisdiction, or other bodies or persons with technical expertise in health. Against this background, this study analyzed 273,734 technical notes on medicines registered on the e-NatJus platform and issued by a total of 25 different NatJus. The results point to large disparities in the recommendations of different NatJus, even when controlling for a range of characteristics of individual cases.},
	type = {preprint},
	note = {Preprint},
	code = {https://github.com/lab-dados/natjus-divergencias},
	language = {en},
	journal = {SciELO Preprints},
	author = {Oliveira, Bruno da Cunha de and Wang, Daniel Wei Liang and Trecenti, Julio and Brajal, Beatriz},
	month = sep,
	year = {2026},
	pdf = {oliveira_natjus_2026.pdf},
	additional_info = {Press coverage: [Futuro da Saúde](https://futurodasaude.com.br/pareceres-dos-natjus-para-tratamentos-variam-entre-estados-aponta-estudo/) and [JOTA](https://mailchi.mp/jota/relatorio-especial-24082026-dispositivos-medicos-8891134).},
	preview = {oliveira_natjus_2026_page-0001.jpg}
}

@article{oliveira_et_al_2025,
	title = {Judicialization of Autism Spectrum Disorder Treatments in Supplementary Health: Analysis of Judgments Delivered by the São Paulo Court of Justice in 2023},
	type = {preprint},
	shorttitle = {Judicialization of Autism Spectrum Disorder Treatments in Supplementary Health},
	html = {https://preprints.scielo.org/index.php/scielo/preprint/view/11566},
	doi = {10.1590/SciELOPreprints.11566},
	note = {Preprint},
	abstract = {Despite the economic, legal, and social relevance of the topic, the judicialization of treatments for autism spectrum disorder in Brazil has yet to be explored in depth in academic literature. To fill this gap, a systematic content analysis was conducted on a representative sample of judgments issued by the São Paulo State Court (TJSP) in 2023. The plaintiffs were predominantly very young children, with an average age of approximately six years and a median age of four years and ten months. The main treatments sought were consultations with speech therapists, occupational therapists, and psychologists. In 66% of the cases, there was a request for a professional trained in the Applied Behavior Analysis technique. The main arguments presented by health insurance operators were related to legal discussions about the obligation to cover the requested treatments. On the other hand, the primary argument used by the judges was that neither the judge nor the operator could review the prescription provided by the patient's doctor. To substantiate their decisions, judges primarily relied on the court's jurisprudence, binding precedents from the TJSP, and the Brazilian Consumer Protection Code. The total or partial success rate for patients was 92%.},
	language = {en},
	urldate = {2025-04-07},
	journal = {SciELO Preprints},
	author = {Oliveira, Bruno da Cunha de and Penha, Maria Sthefanny Cavalcante da and Rodrigues, Giulia Beatriz Brombine Alves and Püschel, Mariana Araujo and Boarati, Vanessa},
	month = apr,
	year = {2025},
	pdf = {oliveira_et_al_2025.pdf},
	additional_info={Press coverage: [Folha de São Paulo](https://www1.folha.uol.com.br/equilibrioesaude/2025/03/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude.shtml) (republished in: [ICL Notícias](https://iclnoticias.com.br/autistas-ganham-9-cada-10-acoes-judiciais/), [Jornal de Brasília](https://jornaldebrasilia.com.br/noticias/saude/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude/), [Amazonas Repórter](https://amazonasreporter.com/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude/), [Vitória News](https://vitorianews.com.br/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude/), [O Juricaba](https://oajuricaba.com.br/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude/), [Contexto Notícias](https://contextonoticias.com.br/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude/) and [Portal do Holanda](https://www.portaldoholanda.com.br/variedades/criancas-autistas-ganham-9-em-cada-10-acoes-judiciais-contra-planos-de-saude)).},
	preview={oliveira_et_al_2025_page-0001.jpg}
}

@article{rocha_barreiras_2025,
	title = {Barriers to the Implementation of a National Lung Cancer Screening Policy},
	type = {preprint},
	html = {https://preprints.scielo.org/index.php/scielo/preprint/view/12922},
	doi = {10.1590/SciELOPreprints.12922},
	note = {Preprint},
	abstract = {Lung cancer is the leading cause of cancer death in Brazil. While low-dose computed tomography (LDCT) screening is effective for early detection, its implementation in the Unified Health System (SUS) faces significant barriers. This study, based on interviews with 18 specialists, mapped these barriers using the Consolidated Framework for Implementation Research (CFIR). The results reveal multifaceted challenges. Within the innovation characteristics domain, there is uncertainty about applying international evidence to the Brazilian epidemiological context, with a risk of increased false positives due to diseases like tuberculosis. The outer setting points to regional inequalities and unstable funding as major obstacles. In the inner setting, the scarcity of human resources and equipment, and the lack of care coordination were highlighted. Individual barriers include a shortage of specialized professionals, the need for training, and low patient adherence, influenced by logistical factors and the stigma of the disease. Finally, the implementation process is hindered by the absence of robust data for effective planning and continuous monitoring. The study concludes that for successful implementation, it is essential to consider and plan solutions for these barriers, adapting the policy to the complex reality of the SUS.},
	language = {en},
	journal = {SciELO Preprints},
	author = {Rocha, Mariana Skaf Esteves da and Püschel, Mariana Araujo and Boarati, Vanessa and Oliveira, Bruno da Cunha de and Melo, Carolina},
	year = {2025},
	pdf = {rocha_barreiras_2025.pdf},
	preview = {rocha_barreiras_2025_page-0001.jpg}
}
